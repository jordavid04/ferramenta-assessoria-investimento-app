# Chave criada no Google AI Studio (https://aistudio.google.com/apikey)
# Sem a chave, o sistema usa o motor de recomendação local (modo offline).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# PostgreSQL (opcional no desenvolvimento; sem ele o resultado não é persistido)
DATABASE_URL=postgresql://investpro:investpro@localhost:5432/investpro

# Segredo do JWT (cookie httpOnly). Sem ele, cadastro e login ficam indisponíveis.
# Use uma string longa e aleatória. O questionário anônimo continua funcionando.
JWT_SECRET=

# Painel econômico: URL base dos dados abertos do Banco Central (opcional).
# Útil só para testes, por exemplo apontando para um endereço inválido para simular a fonte fora do ar.
# BCB_API_URL=https://api.bcb.gov.br
